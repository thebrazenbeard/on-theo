{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "on-theo://astrology/blind-run-v1",
  "title": "Celestial Conditioning Blind Run V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "agents",
    "steps",
    "seed_commitment_sha256",
    "observable_files"
  ],
  "properties": {
    "schema": {
      "const": "ON_THEO_ASTROLOGY_BLIND_RUN_V1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "agents": {
      "type": "integer",
      "minimum": 1
    },
    "steps": {
      "type": "integer",
      "minimum": 1
    },
    "seed_commitment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observable_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
